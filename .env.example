# Copy to .env and adjust. Every value here has a default in recollect.config;
# this file exists so the machine-specific paths are not baked into source.

# --- Embedding (in-process, pinned) ------------------------------------------
# The carried Qwen3-Embedding-0.6B Q8_0 GGUF. Its SHA-256 is asserted against
# the hash pinned in EpisodicConfig on every store open.
RECOLLECT_EMBEDDING_MODEL_PATH=C:\Users\muzaf\.cache\huggingface\hub\Qwen3-Embedding-0.6B-GGUF\Qwen3-Embedding-0.6B-Q8_0.gguf

# Threads only. n_ctx=512, n_gpu_layers=0 and one-text-per-call are pinned in
# code and are part of the vector identity. Thread count measured bit-identical
# across 1/2/4/8/16 on 21 texts; 8 is the latency knee (305ms -> 55ms).
RECOLLECT_EMBEDDING_THREADS=8

# --- Generation (HTTP, OpenAI-compatible) ------------------------------------
RECOLLECT_GENERATOR_BASE_URL=http://127.0.0.1:8001/v1
RECOLLECT_GENERATOR_MODEL=local
RECOLLECT_GENERATOR_API_KEY=not-needed
# Ceilings, not targets: the prompt asks for the shortest sufficient answer
# and these bound the turns that run long. Routing and the background relay
# get their own headroom because a cut routing call loses the delegation and
# a cut relay loses a sentence.
RECOLLECT_GENERATOR_MAX_TOKENS=256
RECOLLECT_GENERATOR_ROUTING_MAX_TOKENS=320
RECOLLECT_TASK_RELAY_MAX_TOKENS=160

# --- Voice (local, optional) --------------------------------------------------
# Install with uv sync --extra voice --inexact, then recollect voice-setup.
# The browser microphone stays open after Enable voice until Stop voice.
RECOLLECT_VOICE_MODEL_DIR=var/models/voice
RECOLLECT_VOICE_WAKE_PHRASE=hey idris
RECOLLECT_VOICE_NAME=af_heart
# auto prefers available CUDA; cuda requires it; cpu selects CPU synthesis.
RECOLLECT_VOICE_DEVICE=auto
# Optional absolute directory containing compatible CUDA 13 and cuDNN 9 DLLs.
# RECOLLECT_VOICE_CUDA_DLL_DIR=C:\path\to\torch\lib
RECOLLECT_VOICE_THREADS=2
RECOLLECT_VOICE_MAX_UTTERANCE_S=120
RECOLLECT_VOICE_WAIT_S=8
RECOLLECT_VOICE_END_S=1.4
RECOLLECT_VOICE_SPEECH_START_S=0.224
RECOLLECT_VOICE_SPEECH_THRESHOLD=0.5
RECOLLECT_VOICE_INTERRUPT_THRESHOLD=0.8
# Optional GPU Whisper dictation; Vosk remains the wake detector.
# Install voice-whisper alongside voice or voice-gpu, then voice-setup --whisper.
RECOLLECT_VOICE_ASR_BACKEND=vosk
RECOLLECT_VOICE_ASR_MODEL_DIR=var/models/voice/whisper-large-v3-turbo
RECOLLECT_VOICE_ASR_DEVICE=cuda
RECOLLECT_VOICE_ASR_COMPUTE_TYPE=float16
# Optional additional absolute CUDA 12/cuDNN 9 DLL directory.
# RECOLLECT_VOICE_ASR_CUDA_DLL_DIR=C:\path\to\cuda12\bin

# --- Research subagent -------------------------------------------------------
# "legacy" is in-process. "opencode" requires Docker and the pinned image
# built from deploy/opencode-sandbox/Dockerfile.
RECOLLECT_SUBAGENT_BACKEND=opencode
# Continuous tasks retain messages and files outside the episodic memory store.
# Requires the pinned OpenCode image and a llama.cpp server with /apply-template
# and /tokenize. Keep false until the deployment's live capability checks pass.
RECOLLECT_SUBAGENT_CONTINUOUS_ENABLED=false
# Must match the deployed per-slot context, not the model's training context.
RECOLLECT_GENERATOR_CONTEXT_TOKENS=32768
# Optional two-slot mode reserves one slot each for conversation and research.
# Match llama-server --parallel 2 --ctx-size 65536; one model, 32768 per slot.
RECOLLECT_GENERATOR_PARALLEL_SLOTS=1
# Per-inference bound only; productive tasks continue across native checkpoints.
RECOLLECT_SUBAGENT_INFERENCE_TOKENS=2048
RECOLLECT_SANDBOX_CONTAINER_RUNTIME=docker
RECOLLECT_SANDBOX_CONTAINER_IMAGE=recollect-opencode-sandbox:1.18.18
RECOLLECT_SANDBOX_CONTAINER_MEMORY_MB=1024
RECOLLECT_SANDBOX_CONTAINER_PIDS=256
RECOLLECT_SANDBOX_CONTAINER_CPUS=2.0
# Optional. Defaults outside the repository to a machine-local sandbox root.
# RECOLLECT_SANDBOX_ROOT=C:\Users\muzaf\AppData\Local\recollect\sandboxes

# --- Storage -----------------------------------------------------------------
# Episode stores and turn traces live here, one subdirectory per session.
RECOLLECT_DATA_DIR=var
# Optional desktop delivery. Files are copied here without overwriting names.
# RECOLLECT_DOWNLOADS_DIR=C:\Users\YOUR_NAME\Downloads

# --- Server ------------------------------------------------------------------
RECOLLECT_HOST=127.0.0.1
RECOLLECT_PORT=8080
